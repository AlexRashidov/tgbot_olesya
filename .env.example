# Токен бота от @BotFather
BOT_TOKEN=

# Строка подключения к SQLite (путь относительно папки проекта или абсолютный)
DATABASE_URL=sqlite:///data/bot.db

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot).
# Им приходят заявки «Я оплатил(а)» и доступны /paid <id> и /stats.
ADMIN_IDS=

# Ссылки на оплату 2 500 ₽ (кнопка не показывается, если ссылка пустая)
PAYMENT_URL_RU=https://paylink.tbank.ru/5251f857-b16e-4920-b890-e7e877766032
PAYMENT_URL_FOREIGN=

# Ссылка на уроки, рабочую тетрадь и методичку (выдаётся после подтверждения оплаты)
MATERIALS_URL=

# Множитель интервалов прогрева. 1 = боевые 24ч/48ч/48ч.
# Для проверки: 0.0007 ≈ 1 мин / 2 мин / 2 мин (и SCHEDULER_TICK_SECONDS=10).
DELAY_SCALE=1
SCHEDULER_TICK_SECONDS=60
