# Токен бота от @BotFather
BOT_TOKEN=

# Строка подключения к SQLite (путь относительно папки проекта или абсолютный)
DATABASE_URL=sqlite:///data/bot.db

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot).
# Им приходят уведомления об оплатах, доступны /texts, /paid <id> и /stats.
ADMIN_IDS=

# Цена и название продукта (используются в платежах и чеке)
PRICE_RUB=2500
PRODUCT_NAME=Таблетка от прокрастинации

# Ссылка на уроки, рабочую тетрадь и методичку (выдаётся в боте после оплаты)
MATERIALS_URL=

# ---------- Веб-сервер для оплаты ----------
# Порт, на котором бот принимает уведомления об оплате и запросы с сайта (0 — выключить).
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Публичный HTTPS-адрес этого сервера (через nginx и т. п.). Без него автооплата не включится.
PUBLIC_BASE_URL=
# Адрес лендинга: сюда платёжная система вернёт покупателя с сайта после оплаты.
SITE_URL=
# С каких адресов сайт может обращаться к серверу (через запятую), обычно = адрес лендинга.
CORS_ORIGINS=

# ---------- Т-Банк (карты РФ) ----------
# Из личного кабинета Т-Бизнеса: Интернет-эквайринг → Магазины → Терминалы.
# Если не заполнено — используется статичная ссылка PAYMENT_URL_RU и ручная проверка оплаты.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
# Чек на почту покупателю (нужна подключённая онлайн-касса в Т-Бизнесе)
TBANK_RECEIPT=1
# Система налогообложения: osn, usn_income, usn_income_outcome, esn, patent
TBANK_TAXATION=usn_income
# НДС: none, vat0, vat5, vat7, vat10, vat20
TBANK_VAT=none

# ---------- Prodamus (иностранные карты) ----------
# Адрес платёжной формы, например https://alisiabosque.payform.ru
# Секретный ключ — в кабинете Prodamus: Настройки → Секретный ключ.
# Если не заполнено — используется статичная ссылка PAYMENT_URL_FOREIGN и ручная проверка.
PRODAMUS_FORM_URL=
PRODAMUS_SECRET=
# Необязательно: ограничить способы оплаты на форме (коды из документации Prodamus)
PRODAMUS_PAYMENT_METHODS=

# ---------- Статичные ссылки (запасной вариант, оплату подтверждает админ) ----------
PAYMENT_URL_RU=https://paylink.tbank.ru/5251f857-b16e-4920-b890-e7e877766032
PAYMENT_URL_FOREIGN=

# ---------- Доступ для покупателей с сайта ----------
# Показываются на странице «Спасибо» только после подтверждённой оплаты.
ACCESS_TG_URL=
ACCESS_VK_URL=
ACCESS_MAX_URL=

# Только для проверки на своём ПК: тестовая форма Prodamus на /dev/payform без списания денег.
# НА СЕРВЕРЕ ВСЕГДА 0.
DEV_FAKE_PAYMENTS=0

# Множитель интервалов прогрева. 1 = боевые 24ч/48ч/48ч.
# Для проверки: 0.0007 ≈ 1 мин / 2 мин / 2 мин (и SCHEDULER_TICK_SECONDS=10).
DELAY_SCALE=1
SCHEDULER_TICK_SECONDS=60
